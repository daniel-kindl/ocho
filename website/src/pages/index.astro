---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadActions from '../components/DownloadActions.astro';
import Icon from '../components/Icon.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import { siteCopy as copy } from '../i18n';
---

<BaseLayout
  title={copy.meta.homeTitle}
  description={copy.meta.homeDescription}
>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid page">
        <div class="hero-copy">
          <p class="eyebrow"><span>{copy.home.hero.eyebrow}</span><span>{copy.home.hero.category}</span></p>
          <h1 id="hero-title">{copy.home.hero.titleLineOne}<br><em>{copy.home.hero.titleLineTwo}</em></h1>
          <p class="hero-lede">{copy.home.hero.lede}</p>
          <DownloadActions class="hero-actions" />
          <div class="hero-meta">
            {copy.home.hero.meta.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <div class="session-dashboard" aria-label={copy.home.hero.previewLabel}>
          <div class="phone-stage">
          <PhoneMockup image="screenshots/v3/tabata-work.png" small={false} alt={copy.home.hero.imageAlt} loading="eager" />
          </div>
          <div class="run-timeline" aria-label={copy.home.hero.timelineLabel}>
            <span class="timeline-prepare"></span><span class="timeline-work"></span><span class="timeline-rest"></span><span class="timeline-work"></span><span class="timeline-rest"></span><span class="timeline-complete"></span>
          </div>
          <div class="dashboard-meta"><span><Icon name="rotate-cw" />{copy.home.hero.mode}</span><span>{copy.home.hero.timing}</span></div>
        </div>
      </div>
    </section>

    <div class="signal-rail" aria-label={copy.home.signals.label}>
      <div class="page signal-inner">
        <span class="signal-label phase-prepare">{copy.home.signals.prepare}</span>
        <span class="signal-label phase-work">{copy.home.signals.work}</span>
        <span class="signal-label phase-rest">{copy.home.signals.rest}</span>
        <span class="signal-label phase-complete">{copy.home.signals.complete}</span>
      </div>
    </div>

    <section class="section session-section" id="session" aria-labelledby="session-title">
      <div class="page feature-grid">
        <div class="feature-copy">
          <p class="eyebrow"><span>{copy.home.session.eyebrow}</span><span>{copy.home.session.category}</span></p>
          <h2 id="session-title">{copy.home.session.title}</h2>
          <p class="section-lede">{copy.home.session.lede}</p>
          <div class="signal-notes">
            {copy.home.session.notes.map((note) => <div><span>{note.index}</span><strong>{note.title}</strong><p>{note.body}</p></div>)}
          </div>
        </div>
        <figure class="setup-visual">
          <div class="screen-pair">
            <PhoneMockup image="screenshots/v4/tabata-presets.png" class="setup-phone" alt={copy.home.session.setupAlt} />
            <PhoneMockup image="screenshots/v3/tabata-rest.png" class="rest-phone" alt={copy.home.session.restAlt} />
          </div>
          <figcaption><span><Icon name="settings" />{copy.home.session.setupCaption}</span><span><Icon name="activity" />{copy.home.session.restCaption}</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="section modes-section" id="modes" aria-labelledby="modes-title">
      <div class="page">
        <div class="modes-heading">
          <p class="eyebrow"><span>{copy.home.modes.eyebrow}</span><span>{copy.home.modes.category}</span></p>
          <h2 id="modes-title">{copy.home.modes.title}</h2>
          <p class="section-lede">{copy.home.modes.lede}</p>
        </div>
        <div class="mode-gallery">
          <div class="mode-legend" aria-label={copy.home.modes.galleryLabel}>
            {copy.home.modes.legend.map((item) => <span><strong>{item.name}</strong><small>{item.detail}</small></span>)}
          </div>
          <div class="mode-phone-row">
          <figure class="mode-phone mode-phone-home">
            <PhoneMockup image="screenshots/v3/home.png" alt={copy.home.modes.homeAlt} />
            <figcaption><span>{copy.home.modes.flow[0].number}</span><span>{copy.home.modes.flow[0].detail}</span></figcaption>
          </figure>
          <figure class="mode-phone mode-phone-setup">
            <PhoneMockup image="screenshots/v4/tabata-presets.png" class="setup-phone" alt={copy.home.modes.setupAlt} />
            <figcaption><span>{copy.home.modes.flow[1].number}</span><span>{copy.home.modes.flow[1].detail}</span></figcaption>
          </figure>
          <figure class="mode-phone mode-phone-work">
            <PhoneMockup image="screenshots/v3/tabata-work.png" alt={copy.home.modes.workAlt} />
            <figcaption><span>{copy.home.modes.flow[2].number}</span><span>{copy.home.modes.flow[2].detail}</span></figcaption>
          </figure>
          </div>
        </div>
        <div class="mode-cards">
          {copy.home.modes.cards.map((card, index) => <article class:list={['mode-card', index === 1 && 'mode-card-featured']}>
            <div class="mode-card-top"><span class="mode-number">{card.number}</span><svg class="icon mode-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={index === 0 ? 'M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2' : index === 2 ? 'M15.914 4a1.5 1.5 0 0 0-2.474-1.561l-9 9A1.5 1.5 0 0 0 5.5 14h4.002a.5.5 0 0 1 .471.666L8.086 20a1.5 1.5 0 0 0 2.475 1.56l9-9A1.5 1.5 0 0 0 18.5 10h-3.997a.5.5 0 0 1-.472-.667z' : 'M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8'}></path>{index !== 0 && index !== 2 && <path d="M21 3v5h-5"></path>}</svg></div>
            <div class="mode-card-main"><h3>{card.name}</h3><p>{card.description}</p></div>
            <div class:list={['mode-preview', `${card.preview}-preview`]} aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="mode-card-meta">{card.meta}</span>
          </article>)}
        </div>
        <div class="coming-note" aria-label={copy.home.modes.comingLabel}>
          <span class="coming-note-index">{copy.home.modes.comingIndex}</span>
          <span class="coming-note-text">{copy.home.modes.comingText}</span>
        </div>
      </div>
    </section>

    <section class="section presets-section" id="presets" aria-labelledby="presets-title">
      <div class="page feature-grid">
        <div class="feature-copy">
          <p class="eyebrow"><span>{copy.home.presets.eyebrow}</span><span>{copy.home.presets.category}</span></p>
          <h2 id="presets-title">{copy.home.presets.title}</h2>
          <p class="section-lede">{copy.home.presets.lede}</p>
          <div class="signal-notes">
            {copy.home.presets.notes.map((note) => <div><span>{note.index}</span><strong>{note.title}</strong><p>{note.body}</p></div>)}
          </div>
        </div>
        <figure class="presets-visual">
          <PhoneMockup image="screenshots/v4/emom-presets.png" alt={copy.home.presets.alt} />
          <figcaption><span><Icon name="activity" />{copy.home.presets.caption}</span><span>{copy.home.presets.detail}</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="section capture-section" id="screenshots" aria-labelledby="screenshots-title">
      <div class="page">
        <div class="capture-heading">
          <p class="eyebrow"><span>{copy.home.screenshots.eyebrow}</span><span>{copy.home.screenshots.category}</span></p>
          <h2 id="screenshots-title">{copy.home.screenshots.title}</h2>
          <p class="section-lede">{copy.home.screenshots.lede}</p>
        </div>
        <div class="capture-grid">
          {copy.home.screenshots.items.map((item) => <figure class="capture-card">
            <PhoneMockup image={item.image} class={item.setup ? 'setup-phone' : undefined} alt={item.alt} />
            <figcaption><strong>{item.title}</strong><span>{item.detail}</span></figcaption>
          </figure>)}
        </div>
      </div>
    </section>

    <section class="download-section" id="download" aria-labelledby="download-title">
      <div class="page download-grid">
        <div>
          <p class="eyebrow"><span>{copy.home.download.eyebrow}</span><span>{copy.home.download.category}</span></p>
          <h2 id="download-title">{copy.home.download.title}</h2>
        </div>
        <div class="download-copy">
          <p>{copy.home.download.body}</p>
          <DownloadActions />
          <p class="download-note">{copy.home.download.note}</p>
        </div>
      </div>
    </section>
</BaseLayout>
