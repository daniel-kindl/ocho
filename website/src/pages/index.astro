---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadActions from '../components/DownloadActions.astro';
import Icon from '../components/Icon.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
---

<BaseLayout
  title="Ocho — interval timer for Android"
  description="Ocho is an offline-first Android interval timer for EMOM, Tabata, AMRAP, and Custom Timer workouts."
>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid page">
        <div class="hero-copy">
          <p class="eyebrow"><span>OCHO / 01</span><span>ANDROID TIMER</span></p>
          <h1 id="hero-title">Keep your eyes<br><em>on the work.</em></h1>
          <p class="hero-lede">A clear interval timer for EMOM, Tabata, AMRAP, and Custom Timer workouts. The clock stays big. The phase stays obvious.</p>
          <DownloadActions class="hero-actions" />
          <div class="hero-meta">
            <span>Android 8.0+</span>
            <span>No account</span>
            <span>GPLv3</span>
          </div>
        </div>

        <div class="session-dashboard" aria-label="Ocho session preview">
          <div class="phone-stage">
            <PhoneMockup image="screenshots/v2/tabata-work.png" small={false} alt="Ocho Tabata work phase screen showing the current interval." loading="eager" />
          </div>
          <div class="run-timeline" aria-label="Tabata run timeline">
            <span class="timeline-prepare"></span><span class="timeline-work"></span><span class="timeline-rest"></span><span class="timeline-work"></span><span class="timeline-rest"></span><span class="timeline-complete"></span>
          </div>
          <div class="dashboard-meta"><span><Icon name="rotate-cw" />tabata</span><span>45s work / 15s rest</span></div>
        </div>
      </div>
    </section>

    <div class="signal-rail" aria-label="Ocho phase signals">
      <div class="page signal-inner">
        <span class="signal-label phase-prepare">Prepare</span>
        <span class="signal-label phase-work">Work</span>
        <span class="signal-label phase-rest">Rest</span>
        <span class="signal-label phase-complete">Complete</span>
      </div>
    </div>

    <section class="section session-section" id="session" aria-labelledby="session-title">
      <div class="page feature-grid">
        <div class="feature-copy">
          <p class="eyebrow"><span>OCHO / 02</span><span>THE SESSION</span></p>
          <h2 id="session-title">The phase is the interface.</h2>
          <p class="section-lede">Ocho does not hide the important part in a small label. Work and rest take over the screen, with sound and vibration at the same moment.</p>
          <div class="signal-notes">
            <div><span>01</span><strong>See it</strong><p>Full-screen colour and a large clock.</p></div>
            <div><span>02</span><strong>Hear it</strong><p>A cue at every phase boundary.</p></div>
            <div><span>03</span><strong>Feel it</strong><p>Vibration when the interval changes.</p></div>
          </div>
        </div>
        <figure class="setup-visual">
          <div class="screen-pair">
            <PhoneMockup image="screenshots/v2/tabata-setup.png" class="setup-phone" alt="Ocho Tabata setup screen with duration pickers and a visual round preview." />
            <PhoneMockup image="screenshots/v2/tabata-rest.png" class="rest-phone" alt="Ocho Tabata rest phase screen showing the recovery interval." />
          </div>
          <figcaption><span><Icon name="settings" />SETUP / TABATA</span><span><Icon name="activity" />REST / 00:08</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="section modes-section" id="modes" aria-labelledby="modes-title">
      <div class="page">
        <div class="modes-heading">
          <p class="eyebrow"><span>OCHO / 03</span><span>CHOOSE A RHYTHM</span></p>
          <h2 id="modes-title">Choose your timer.</h2>
          <p class="section-lede">Four formats. No feed, profile, or subscription between you and the start button.</p>
        </div>
        <div class="mode-gallery">
          <div class="mode-legend" aria-label="Ocho workout modes">
            <span><strong>EMOM</strong><small>continuous work</small></span>
            <span><strong>Tabata</strong><small>work / rest</small></span>
            <span><strong>AMRAP</strong><small>one unbroken block</small></span>
            <span><strong>Custom</strong><small>sets / intervals</small></span>
          </div>
          <div class="mode-phone-row">
          <figure class="mode-phone mode-phone-home">
            <PhoneMockup image="screenshots/v2/home.png" alt="Ocho home screen with EMOM, Tabata, AMRAP, and Custom Timer workout modes." />
            <figcaption><span>01 / CHOOSE</span><span>pick a mode</span></figcaption>
          </figure>
          <figure class="mode-phone mode-phone-setup">
            <PhoneMockup image="screenshots/v2/tabata-setup.png" class="setup-phone" alt="Ocho Tabata setup screen with duration pickers and a visual round preview." />
            <figcaption><span>02 / CONFIGURE</span><span>set the pace</span></figcaption>
          </figure>
          <figure class="mode-phone mode-phone-work">
            <PhoneMockup image="screenshots/v2/tabata-work.png" alt="Ocho Tabata work phase showing the current interval." />
            <figcaption><span>03 / START</span><span>keep moving</span></figcaption>
          </figure>
          </div>
        </div>
        <div class="mode-cards">
          <article class="mode-card">
            <div class="mode-card-top"><span class="mode-number">01</span><svg class="icon mode-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></div>
            <div class="mode-card-main"><h3>EMOM</h3><p>Every minute on the minute.</p></div>
            <div class="mode-preview emom-preview" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="mode-card-meta">continuous work / interval cue</span>
          </article>
          <article class="mode-card mode-card-featured">
            <div class="mode-card-top"><span class="mode-number">02</span><svg class="icon mode-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></div>
            <div class="mode-card-main"><h3>Tabata</h3><p>Work and rest alternate.</p></div>
            <div class="mode-preview tabata-preview" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="mode-card-meta">phase colour / audio cue</span>
          </article>
          <article class="mode-card">
            <div class="mode-card-top"><span class="mode-number">03</span><svg class="icon mode-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 0 0-2.474-1.561l-9 9A1.5 1.5 0 0 0 5.5 14h4.002a.5.5 0 0 1 .471.666L8.086 20a1.5 1.5 0 0 0 2.475 1.56l9-9A1.5 1.5 0 0 0 18.5 10h-3.997a.5.5 0 0 1-.472-.667z"></path></svg></div>
            <div class="mode-card-main"><h3>AMRAP</h3><p>As many rounds as possible.</p></div>
            <div class="mode-preview amrap-preview" aria-hidden="true"><span></span></div>
            <span class="mode-card-meta">one block / no interval beeps</span>
          </article>
          <article class="mode-card">
            <div class="mode-card-top"><span class="mode-number">04</span><svg class="icon mode-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></div>
            <div class="mode-card-main"><h3>Custom Timer</h3><p>Set your own rounds and intervals.</p></div>
            <div class="mode-preview tabata-preview" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="mode-card-meta">work / rest / no final rest</span>
          </article>
        </div>
        <div class="coming-note" aria-label="More workout modes coming soon">
          <span class="coming-note-index">04 / NEXT</span>
          <span class="coming-note-text">More ways to train, coming soon.</span>
        </div>
      </div>
    </section>

    <section class="section capture-section" id="screenshots" aria-labelledby="screenshots-title">
      <div class="page">
        <div class="capture-heading">
          <p class="eyebrow"><span>OCHO / 04</span><span>THE FULL FLOW</span></p>
          <h2 id="screenshots-title">Every phase stays obvious.</h2>
          <p class="section-lede">Real Pixel 9a captures from choosing a mode to the final bell. EMOM stays continuous; Tabata makes work and rest unmistakable.</p>
        </div>
        <div class="capture-grid">
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/home.png" alt="Ocho home screen with EMOM, Tabata, AMRAP, and Custom Timer workout modes." />
            <figcaption><strong>01 / CHOOSE</strong><span>pick a mode</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/emom-setup.png" alt="Ocho EMOM setup screen with a one-minute interval." />
            <figcaption><strong>02 / EMOM SETUP</strong><span>set the interval</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/prepare.png" alt="Ocho prepare countdown before the first interval." />
            <figcaption><strong>03 / PREPARE</strong><span>get into position</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/emom-work.png" alt="Ocho EMOM work phase showing the current interval." />
            <figcaption><strong>04 / EMOM WORK</strong><span>keep moving</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/emom-paused.png" alt="Ocho paused EMOM session with a clear resume control." />
            <figcaption><strong>05 / PAUSED</strong><span>resume anytime</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/tabata-setup.png" alt="Ocho Tabata setup screen with work, rest, and round controls." />
            <figcaption><strong>06 / TABATA SETUP</strong><span>build the rhythm</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/tabata-work.png" alt="Ocho Tabata work phase showing the current interval." />
            <figcaption><strong>07 / TABATA WORK</strong><span>push the interval</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/custom-setup.png" class="setup-phone" alt="Ocho Custom Timer setup screen with rounds, work time, and rest time controls." />
            <figcaption><strong>08 / CUSTOM SETUP</strong><span>make it yours</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/tabata-rest.png" alt="Ocho Tabata rest phase showing the recovery interval." />
            <figcaption><strong>09 / TABATA REST</strong><span>recover for the next round</span></figcaption>
          </figure>
          <figure class="capture-card">
            <PhoneMockup image="screenshots/v2/finish.png" alt="Ocho complete screen showing the finished workout summary." />
            <figcaption><strong>10 / COMPLETE</strong><span>finish strong</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="download-section" id="download" aria-labelledby="download-title">
      <div class="page download-grid">
        <div>
          <p class="eyebrow"><span>OCHO / 05</span><span>GET THE APP</span></p>
          <h2 id="download-title">Start with the build that exists today.</h2>
        </div>
        <div class="download-copy">
          <p>Google Play is coming soon. The current GitHub release is available as a manually installed APK for Android 8.0 and later.</p>
          <DownloadActions />
          <p class="download-note">The GitHub build may ask for permission to install an app from an unknown source.</p>
        </div>
      </div>
    </section>
</BaseLayout>
