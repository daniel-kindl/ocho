---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import { siteCopy as copy } from '../i18n';

const homeHref = withBase('');
---

<BaseLayout
  title={copy.meta.privacyTitle}
  description={copy.meta.privacyDescription}
  currentPage="privacy"
  type="article"
>
    <section class="policy-section" aria-labelledby="policy-title">
      <div class="page policy-layout">
        <div class="policy-intro">
          <p class="eyebrow"><span>{copy.privacy.eyebrow}</span><span>{copy.privacy.category}</span></p>
          <h1 id="policy-title">{copy.privacy.title}</h1>
          <p class="policy-lede">{copy.privacy.lede}</p>
          <div class="policy-intro-meta">
            <span>{copy.privacy.lastUpdated}</span>
            <a class="text-link" href={homeHref}>{copy.privacy.back}</a>
          </div>
        </div>

        <article class="policy-article">
          <div class="policy-summary">
            <p class="policy-summary-label">{copy.privacy.summaryLabel}</p>
            <p class="policy-lead">{copy.privacy.summaryLead}</p>
            <div class="policy-summary-points">
              {copy.privacy.summaryPoints.map((point) => <span><strong>{point.title}</strong><small>{point.detail}</small></span>)}
            </div>
          </div>

          <h2><span>{copy.privacy.sections[0].number}</span><span class="policy-heading">{copy.privacy.sections[0].title}</span></h2>
          {copy.privacy.sections[0].paragraphs.map((paragraph) => <p>{paragraph}</p>)}

          <h2><span>{copy.privacy.sections[1].number}</span><span class="policy-heading">{copy.privacy.sections[1].title}</span></h2>
          <p>{copy.privacy.sections[1].paragraphs[0]}</p>
          <p>{copy.privacy.sections[1].paragraphs[1].split('REQUEST_INSTALL_PACKAGES')[0]}<code>REQUEST_INSTALL_PACKAGES</code>{copy.privacy.sections[1].paragraphs[1].split('REQUEST_INSTALL_PACKAGES')[1]}</p>

          <h2><span>{copy.privacy.sections[2].number}</span><span class="policy-heading">{copy.privacy.sections[2].title}</span></h2>
          <p>{copy.privacy.licenseLead} <a href="https://github.com/daniel-kindl/ocho/blob/main/LICENSE">{copy.privacy.gplLicense}</a> {copy.privacy.licenseJoin} <a href="https://github.com/daniel-kindl/ocho/blob/main/THIRD-PARTY-NOTICES.md">{copy.privacy.thirdPartyNotices}</a>.</p>

          <h2><span>{copy.privacy.sections[3].number}</span><span class="policy-heading">{copy.privacy.sections[3].title}</span></h2>
          <p>{copy.privacy.contactLead} <a href="mailto:support@daniel-kindl.dev">{copy.privacy.email}</a> {copy.privacy.contactJoin} <a href="https://github.com/daniel-kindl/ocho/issues">{copy.privacy.issueTracker}</a>.</p>

          <p class="policy-source"><a href="https://github.com/daniel-kindl/ocho/blob/main/docs/PRIVACY_POLICY.md">{copy.privacy.source} <span aria-hidden="true">↗</span></a></p>
        </article>
      </div>
    </section>
</BaseLayout>
