---
import { siteCopy as copy } from '../../i18n';
---
<!doctype html>
<html lang={copy.locale}>
<head>
  <meta charset="utf-8">
  <title>{copy.tools.mockupExportTitle}</title>
  <style>
    :root {
      --work: #b3282d;
      --rest: #5ca47c;
      --bg: #0c110f;
    }

    * { box-sizing: border-box; }
    html, body { width: 420px; height: 740px; margin: 0; background: transparent; }
    body { overflow: hidden; }
    .canvas { display: grid; width: 420px; height: 740px; place-items: center; }
    .phone-shell {
      position: relative;
      z-index: 1;
      width: 300px;
      padding: 40px 10px 10px;
      border: 2px solid #4b5a52;
      border-radius: 36px;
      background: #080b0a;
      box-shadow: 0 28px 60px rgba(0, 0, 0, .5), 0 0 0 1px rgba(255, 255, 255, .06);
    }
    .phone-shell.work { transform: rotate(2.5deg); }
    .phone-shell.rest { transform: rotate(2deg); }
    .phone-shell.setup { transform: rotate(-2deg); }
    .phone-speaker {
      position: absolute;
      z-index: 2;
      top: 15px;
      left: 50%;
      width: 58px;
      height: 5px;
      border-radius: 999px;
      background: #101512;
      transform: translateX(-50%);
    }
    .phone-screen { overflow: hidden; border-radius: 25px; background: var(--bg); }
    .phone-screen.work { background: var(--work); }
    .phone-screen.rest { background: var(--rest); }
    .phone-screen img { display: block; width: 100%; height: auto; }
    .phone-home-indicator { display: none; }
  </style>
</head>
<body>
    <main class="canvas" data-screen-alt-prefix={copy.tools.mockupScreenAltPrefix}>
    <div id="phone" class="phone-shell">
      <div class="phone-speaker" aria-hidden="true"></div>
      <div id="screen" class="phone-screen"><img id="screen-image" alt=""></div>
      <div class="phone-home-indicator" aria-hidden="true"></div>
    </div>
  </main>
  <script>
    const screens = {
      home: "v3/home.png",
      "emom-setup": "v4/emom-presets.png",
      prepare: "v3/prepare.png",
      "emom-work": "v3/emom-work.png",
      "emom-paused": "v3/emom-paused.png",
      "tabata-setup": "v4/tabata-presets.png",
      "custom-setup": "v3/custom-setup.png",
      presets: "v4/emom-presets.png",
      "tabata-presets": "v4/tabata-presets.png",
      "amrap-presets": "v4/amrap-presets.png",
      "custom-presets": "v4/custom-presets.png",
      "tabata-work": "v3/tabata-work.png",
      "tabata-rest": "v3/tabata-rest.png",
      finish: "v3/finish.png"
    };
    const key = (location.hash.slice(1) || "home").toLowerCase();
    const selected = screens[key] ? key : "home";
    const styleKey = selected.includes("work") ? "work" : selected.includes("rest") ? "rest" : selected.includes("setup") ? "setup" : selected;
    document.getElementById("phone").classList.add(styleKey);
    document.getElementById("screen").classList.add(styleKey);
    document.getElementById("screen-image").src = screens[selected];
    const altPrefix = document.querySelector('.canvas').dataset.screenAltPrefix;
    document.getElementById("screen-image").alt = `${altPrefix}${selected} screen`;
  </script>
</body>
</html>
