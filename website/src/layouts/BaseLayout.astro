---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { withBase } from '../utils/paths';
import { siteCopy as copy } from '../i18n';

interface Props {
  title: string;
  description: string;
  currentPage?: 'home' | 'privacy';
  type?: 'website' | 'article';
}

const { title, description, currentPage = 'home', type = 'website' } = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/');
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site) : new URL(canonicalPath, Astro.url);
const socialImageUrl = Astro.site
  ? new URL(withBase('social/ocho-social-1200x630.png'), Astro.site)
  : new URL(withBase('social/ocho-social-1200x630.png'), Astro.url);
---

<!doctype html>
<html lang={copy.locale}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta name="robots" content="index,follow">
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl.href}>
    <link rel="icon" type="image/png" sizes="512x512" href={withBase('favicon.png')}>
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="Ocho">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl.href}>
    <meta property="og:image" content={socialImageUrl.href}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImageUrl.href}>
  </head>
  <body>
    <SiteHeader currentPage={currentPage} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter currentPage={currentPage} />
  </body>
</html>
