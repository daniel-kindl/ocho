---
interface Props {
  class?: string;
}

import { siteCopy as copy } from '../i18n';
import { githubReleaseUrl, playListing } from '../site-config';

const { class: className = 'download-actions' } = Astro.props;
---

<div class={className}>
  <a class="download-badge-link" href={playListing.url} target="_blank" rel="noopener noreferrer" aria-label={playListing.ariaLabel}>
    <img
      class="download-badge"
      src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
      alt="Get it on Google Play"
      width="646"
      height="250"
      loading="lazy"
    />
  </a>
  <a class="download-badge-link" href={githubReleaseUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.downloads.githubAria}>
    <img
      class="download-badge"
      src="/ocho/badges/github-apk.svg"
      alt="Download the Ocho APK from GitHub"
      width="646"
      height="250"
      loading="lazy"
    />
  </a>
</div>

<style>
  .download-badge-link {
    display: inline-flex;
    align-items: center;
    border-radius: 0.5rem;
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .download-badge-link:hover {
    transform: translateY(-2px);
  }

  .download-badge-link:active {
    transform: translateY(0);
  }

  .download-badge {
    display: block;
    width: auto;
    height: 60px;
  }

  @media (max-width: 480px) {
    .download-badge {
      height: 54px;
    }
  }
</style>
