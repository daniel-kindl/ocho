---
interface Props {
  class?: string;
}

const { class: className = 'download-actions' } = Astro.props;
---

<div class={className}>
  <span class="cta cta-primary" aria-label="Google Play coming soon"><span class="cta-copy"><strong>Google Play</strong><small>coming soon</small></span><span class="cta-mark" aria-hidden="true"></span></span>
  <a class="cta cta-secondary" href="https://github.com/daniel-kindl/ocho/releases/latest"><span class="cta-copy"><strong>GitHub APK</strong><small>available now</small></span><span class="cta-arrow" aria-hidden="true">↗</span></a>
</div>
